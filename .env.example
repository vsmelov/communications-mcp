# Скопируй в .env и заполни. .env в .gitignore — секреты наружу не уходят.

# --- Обязательное: Telegram API ---
# Получить на https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Сеть ---
# Техники подключения по порядку, до первой рабочей. Через запятую.
# "direct" = без прокси. Пример для VPN в TUN-режиме, где прокси-порт не слушается:
#   TELEGRAM_PROXY_CHAIN=direct,http://127.0.0.1:10801
# Если не задано — используется TELEGRAM_PROXY (ниже) плюс direct как фолбэк.
TELEGRAM_PROXY_CHAIN=

# Устаревший вариант на один прокси. Работает, но TELEGRAM_PROXY_CHAIN гибче.
# Схемы: http://, socks5://
TELEGRAM_PROXY=

# Сколько секунд ждать одну технику подключения, прежде чем пробовать следующую.
TELEGRAM_CONNECT_TIMEOUT=10

# --- Сессия ---
# Путь к файлу Telethon-сессии. По умолчанию sessions/mcp.session.
# Каждому MCP-клиенту (Claude Code, Claude Desktop, Cursor) нужна СВОЯ копия
# файла, иначе процессы дерутся за SQLite-локи. Подробности в README.
TELEGRAM_SESSION=

# --- tg-archive (опционально) ---
# Нужны, только если поднимаешь фоновый архиватор из tg-archive/.
# Корень его данных: MCP читает оттуда готовые дампы.
TELEGRAM_ARCHIVE_ROOT=
# HTTP-адрес сервиса архиватора (дефолт http://127.0.0.1:8722).
TELEGRAM_ARCHIVE_URL=

# --- Расшифровка и описание вложений (опционально) ---
# Нужен, только если в tg-archive/config.yaml включён transcribe с provider: openai.
# При provider: telegram (по умолчанию) расшифровка бесплатная, ключ не нужен.
OPENAI_API_KEY=

# Нужен, только если в tg-archive/config.yaml включён describe (описание картинок
# и PDF дешёвой vision-моделью). Ключ с https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
